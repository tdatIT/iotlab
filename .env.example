# Copy to .env and fill in. Never commit .env.

# Public hostname of the API (DNS A record -> this host). Used by Traefik + Let's Encrypt.
API_DOMAIN=iotlab.example.com
ACME_EMAIL=admin@example.com
# Staging CA by default (untrusted test certs). Switch once DNS + ports work:
# ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# TimescaleDB
DB_USERNAME=devlab
DB_PASSWORD=
DB_NAME=telemetry
DB_PORT=5432

# Mosquitto (ESP32 devices use the same credentials)
MQTT_USERNAME=iotlab
MQTT_PASSWORD=
MQTT_PORT=1883

# iotlab-service
# Image built by GitHub Actions (required), e.g. docker.io/<dockerhub-user>/iotlab-service:latest
IOTLAB_SERVICE_IMAGE=
LOGGER_LEVEL=info
APP_PORT=3000
ROUTERATELIMIT_RATE=5
ROUTERATELIMIT_BURST=10

# Traefik
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_LOG_LEVEL=INFO
# DOCKER_SOCK=/run/podman/podman.sock
