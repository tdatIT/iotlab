{
    "swagger": "2.0",
    "info": {
        "description": "HTTP API of the iotlab-service. Every endpoint answers with the shared\nresponse envelope: `code` carries the domain outcome, `data` the payload.",
        "title": "IoT Service API",
        "contact": {},
        "version": "1.0.0"
    },
    "host": "localhost:3000",
    "basePath": "/api/v1",
    "paths": {
        "/devices": {
            "get": {
                "description": "Returns every registered device ordered by device id.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "List devices",
                "responses": {
                    "200": {
                        "description": "Devices",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.BaseRes"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/devicedtos.DeviceDTO"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    }
                }
            }
        },
        "/devices/{id}/sensor/average-24h": {
            "get": {
                "description": "Returns the average temperature and humidity of the last 24h, computed from the 30-minute buckets.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Get 24h average temperature/humidity",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Averages",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.BaseRes"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/devicedtos.SensorAverageDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Invalid device id",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    }
                }
            }
        },
        "/devices/{id}/sensor/current": {
            "get": {
                "description": "Returns the newest sensor reading of the device.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Get current temperature/humidity",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Newest reading",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.BaseRes"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/devicedtos.SensorDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Invalid device id",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "404": {
                        "description": "Device has no reading",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    }
                }
            }
        },
        "/devices/{id}/sensor/stats": {
            "get": {
                "description": "Returns the raw sensor series of the window plus a min/max/avg summary.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Get temperature/humidity stats",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            "30m",
                            "60m",
                            "90m"
                        ],
                        "type": "string",
                        "description": "Window",
                        "name": "range",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Series and summary",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.BaseRes"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/devicedtos.SensorStatsDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Invalid device id or range",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    }
                }
            }
        },
        "/devices/{id}/sensor/stats-24h": {
            "get": {
                "description": "Returns the 30-minute buckets of the last 24h plus a min/max/avg summary.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Get 24h temperature/humidity stats",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Buckets and summary",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.BaseRes"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/devicedtos.SensorStats24hDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Invalid device id",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    }
                }
            }
        },
        "/devices/{id}/telemetry/current": {
            "get": {
                "description": "Returns the newest telemetry report of the device.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Get current telemetry",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Newest report",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.BaseRes"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/devicedtos.TelemetryDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Invalid device id",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "404": {
                        "description": "Device has no telemetry",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    }
                }
            }
        },
        "/devices/{id}/telemetry/stats": {
            "get": {
                "description": "Returns the telemetry series of the window plus an RSSI/heap min/max/avg summary.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Get telemetry stats",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            "15m",
                            "30m",
                            "60m"
                        ],
                        "type": "string",
                        "description": "Window",
                        "name": "range",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Series and summary",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.BaseRes"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/devicedtos.TelemetryStatsDTO"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Invalid device id or range",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "$ref": "#/definitions/response.BaseRes"
                        }
                    }
                }
            }
        }
    },
