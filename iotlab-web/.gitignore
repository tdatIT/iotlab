# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local env files — never commit secrets
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Test / coverage
coverage/
*.lcov

# Temp scratch scripts (verify*.tmp.mjs pattern used during development)
*.tmp.mjs
*.tmp.*

# TypeScript incremental build info
*.tsbuildinfo

# Vite cache
.vite/

# Vercel
.vercel
